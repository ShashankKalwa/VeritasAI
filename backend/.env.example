# VeritasAI Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase ──
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── HuggingFace (BERT + ClaimBuster) ──
HF_API_TOKEN=your_huggingface_token
CLAIMBUSTER_HF_MODEL=whispAI/ClaimBuster-DeBERTaV2

# ── Google Fact Check Tools API ──
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_key

# ── v2: Google Gemini LLM (claim extraction + evidence reasoning) ──
# Get your key from https://aistudio.google.com
GOOGLE_AI_API_KEY=TODO_your_gemini_api_key

# LLM model names (override if needed)
LLM_MODEL_EXTRACT=gemini-2.5-flash
LLM_MODEL_REASON=gemini-2.5-pro

# ── v2: Search API (evidence retrieval) ──
# Recommended: Tavily (https://tavily.com)
SEARCH_API_PROVIDER=tavily
SEARCH_API_KEY=TODO_your_tavily_key

# ── v2: Pipeline defaults (no user action needed) ──
MAX_CLAIMS=5
MAX_EVIDENCE_PER_CLAIM=6
CLAIMBUSTER_GATE_THRESHOLD=40
SOURCE_CREDIBILITY_CONFIG_PATH=backend/config/source_credibility.json

# ── v3: Redis Cache (Upstash) ──
UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token
CACHE_TAVILY_TTL=21600
CACHE_FACTCHECK_TTL=43200
CACHE_HF_TTL=86400
CACHE_EXTRACTION_TTL=86400

# ── v4: Rate Limiting ──
UPSTASH_REDIS_PROTOCOL_URL=
ADMIN_API_KEY=
DAILY_LIMIT_ANALYZE=200
